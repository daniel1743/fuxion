{
  "name": "bienestar-en-claro-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host :: --port 3000",
    "build": "node scripts/regenerate-all-icons.cjs && node scripts/generate-sitemap-final.cjs && vite build",
    "sitemap": "node scripts/generate-sitemap-final.cjs",
    "preview": "vite preview --host :: --port 3000",
    "compress-images": "node scripts/compress-product-images.js",
    "security:test": "node --test tests/security/*.test.cjs",
    "security:scan": "node scripts/security-scan.cjs",
    "editorial:slice1": "node src/modules/editor-ia/slice1/cli.js process",
    "editorial:verify": "node src/modules/editor-ia/slice1/cli.js verify",
    "editorial:restore": "node src/modules/editor-ia/slice1/cli.js restore",
    "editorial:test": "node --test tests/editorial-slice1/*.test.js",
    "editorial:coverage": "node --test --experimental-test-coverage tests/editorial-slice1/*.test.js"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/supabase-js": "^2.78.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "firebase": "^12.6.0",
    "framer-motion": "^10.16.4",
    "fuse.js": "^7.5.0",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.0.0",
    "lucide-react": "0.292.0",
    "pdf-parse": "^2.2.2",
    "puppeteer-core": "^25.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.16.0",
    "react-to-print": "^3.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.8.3",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.16",
    "browser-image-compression": "^2.0.2",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "jest": "^30.4.2",
    "postcss": "^8.4.31",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.5"
  }
}
