{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bienestarenclaro.cl/schemas/editorial-pipeline-output-bundle-v1.json",
  "title": "Editorial Pipeline Output Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnostico_editorial",
    "mapa_de_evidencia",
    "validacion_final",
    "pendientes_humanos",
    "manifiesto_de_lote"
  ],
  "properties": {
    "diagnostico_editorial": { "$ref": "#/$defs/diagnostico_editorial" },
    "mapa_de_evidencia": { "$ref": "#/$defs/mapa_de_evidencia" },
    "validacion_final": { "$ref": "#/$defs/validacion_final" },
    "pendientes_humanos": { "$ref": "#/$defs/pendientes_humanos" },
    "manifiesto_de_lote": { "$ref": "#/$defs/manifiesto_de_lote" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "diagnostico_editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "article_id",
        "titulo_actual",
        "pregunta_principal",
        "intencion_de_busqueda",
        "perfil_probable_lector",
        "decision_posterior_probable",
        "responde_la_pregunta",
        "justificacion_respuesta",
        "existe_principalmente_para_seo",
        "nivel_de_riesgo",
        "justificacion_del_riesgo",
        "problemas_detectados",
        "afirmaciones_que_requieren_fuente",
        "posibles_danos",
        "accion_editorial_recomendada",
        "revision_profesional_requerida",
        "especialidad_sugerida",
        "publicacion_bloqueada",
        "confianza",
        "pendientes_humanos"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "article_id": { "$ref": "#/$defs/non_empty_string" },
        "titulo_actual": { "$ref": "#/$defs/non_empty_string" },
        "pregunta_principal": { "$ref": "#/$defs/non_empty_string" },
        "intencion_de_busqueda": {
          "type": "string",
          "enum": ["informacional", "comparativa", "navegacional", "transaccional", "mixta", "no_clara"]
        },
        "perfil_probable_lector": { "$ref": "#/$defs/non_empty_string" },
        "decision_posterior_probable": { "$ref": "#/$defs/non_empty_string" },
        "responde_la_pregunta": {
          "type": "string",
          "enum": ["si", "parcialmente", "no", "no_verificado"]
        },
        "justificacion_respuesta": { "$ref": "#/$defs/non_empty_string" },
        "existe_principalmente_para_seo": {
          "type": "string",
          "enum": ["si", "probablemente", "no", "no_verificado"]
        },
        "nivel_de_riesgo": {
          "type": "string",
          "enum": ["A", "B", "C"]
        },
        "justificacion_del_riesgo": { "$ref": "#/$defs/non_empty_string" },
        "problemas_detectados": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["codigo", "severidad", "descripcion", "ubicacion"],
            "properties": {
              "codigo": { "$ref": "#/$defs/non_empty_string" },
              "severidad": { "enum": ["info", "baja", "media", "alta", "bloqueante"] },
              "descripcion": { "$ref": "#/$defs/non_empty_string" },
              "ubicacion": { "type": "string" }
            }
          }
        },
        "afirmaciones_que_requieren_fuente": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "afirmacion", "motivo"],
            "properties": {
              "claim_id": { "$ref": "#/$defs/non_empty_string" },
              "afirmacion": { "$ref": "#/$defs/non_empty_string" },
              "motivo": { "$ref": "#/$defs/non_empty_string" }
            }
          }
        },
        "posibles_danos": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "accion_editorial_recomendada": {
          "enum": [
            "conservar_sin_cambios",
            "corregir_cambios_menores",
            "reescribir",
            "fusionar_con_otro_articulo",
            "redirigir_301",
            "despublicar_temporalmente",
            "eliminar_con_revision_humana",
            "bloquear_hasta_revision_profesional"
          ]
        },
        "revision_profesional_requerida": { "type": "boolean" },
        "especialidad_sugerida": {
          "type": ["string", "null"]
        },
        "publicacion_bloqueada": { "type": "boolean" },
        "confianza": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pendientes_humanos": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "nivel_de_riesgo": { "const": "C" } },
            "required": ["nivel_de_riesgo"]
          },
          "then": {
            "properties": {
              "revision_profesional_requerida": { "const": true },
              "publicacion_bloqueada": { "const": true }
            }
          }
        }
      ]
    },
    "mapa_de_evidencia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "article_id", "claims", "verificado_en"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "article_id": { "$ref": "#/$defs/non_empty_string" },
        "verificado_en": {
          "type": "string",
          "format": "date-time"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "afirmacion",
              "tipo_de_afirmacion",
              "fuentes",
              "poblacion",
              "resultado_medido",
              "limitaciones",
              "respaldo_completo",
              "estado_de_verificacion",
              "fecha_de_verificacion"
            ],
            "properties": {
              "claim_id": { "$ref": "#/$defs/non_empty_string" },
              "afirmacion": { "$ref": "#/$defs/non_empty_string" },
              "tipo_de_afirmacion": {
                "enum": ["clinica", "cifra", "dosis", "plazo", "mecanismo", "causalidad", "asociacion", "diagnostico", "tratamiento", "seguridad", "otra"]
              },
              "fuentes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["titulo", "identificador", "tipo_de_fuente", "url", "estado_de_verificacion"],
                  "properties": {
                    "titulo": { "$ref": "#/$defs/non_empty_string" },
                    "autores": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "anio": {
                      "type": ["integer", "null"],
                      "minimum": 1800,
                      "maximum": 2100
                    },
                    "identificador": { "type": ["string", "null"] },
                    "tipo_de_fuente": {
                      "enum": ["guia_clinica", "revision_sistematica", "metaanalisis", "ensayo_clinico", "estudio_observacional", "ficha_regulatoria", "organismo_oficial", "otra"]
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "estado_de_verificacion": {
                      "enum": ["verificada", "parcialmente_verificada", "no_verificada", "metadatos_incorrectos", "posiblemente_inventada"]
                    }
                  }
                }
              },
              "poblacion": { "type": ["string", "null"] },
              "resultado_medido": { "type": ["string", "null"] },
              "limitaciones": {
                "type": "array",
                "items": { "type": "string" }
              },
              "respaldo_completo": { "type": "boolean" },
              "estado_de_verificacion": {
                "enum": ["verificada", "parcialmente_verificada", "no_verificada", "metadatos_incorrectos", "posiblemente_inventada"]
              },
              "fecha_de_verificacion": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "validacion_final": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "article_id", "estado_general", "checks", "bloqueos", "validado_en"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "article_id": { "$ref": "#/$defs/non_empty_string" },
        "estado_general": {
          "enum": ["cumple", "no_cumple", "no_aplica", "no_verificado", "requiere_revision_humana"]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["codigo", "estado", "detalle", "bloqueante"],
            "properties": {
              "codigo": { "$ref": "#/$defs/non_empty_string" },
              "estado": {
                "enum": ["cumple", "no_cumple", "no_aplica", "no_verificado", "requiere_revision_humana"]
              },
              "detalle": { "$ref": "#/$defs/non_empty_string" },
              "bloqueante": { "type": "boolean" }
            }
          }
        },
        "bloqueos": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "validado_en": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "pendientes_humanos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "article_id", "items"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "article_id": { "$ref": "#/$defs/non_empty_string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pending_id", "tipo", "descripcion", "esencial", "estado"],
            "properties": {
              "pending_id": { "$ref": "#/$defs/non_empty_string" },
              "tipo": {
                "enum": ["editorial", "cientifico", "medico", "legal", "seo", "tecnico", "comercial"]
              },
              "descripcion": { "$ref": "#/$defs/non_empty_string" },
              "esencial": { "type": "boolean" },
              "asignado_a": { "type": ["string", "null"] },
              "estado": {
                "enum": ["pendiente", "en_revision", "resuelto", "rechazado"]
              }
            }
          }
        }
      }
    },
    "manifiesto_de_lote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "pipeline_version",
        "dry_run",
        "source",
        "started_at",
        "status",
        "limits",
        "articles",
        "cost"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "run_id": { "$ref": "#/$defs/non_empty_string" },
        "pipeline_version": { "$ref": "#/$defs/non_empty_string" },
        "dry_run": { "const": true },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "environment"],
          "properties": {
            "kind": { "enum": ["fixture", "export_local", "supabase_read_only"] },
            "environment": { "enum": ["local", "test", "staging"] }
          }
        },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "status": { "enum": ["created", "running", "completed", "failed", "cancelled", "blocked"] },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["batch_size", "concurrency", "max_cost"],
          "properties": {
            "batch_size": { "type": "integer", "minimum": 1, "maximum": 3 },
            "concurrency": { "type": "integer", "const": 1 },
            "max_cost": { "type": "number", "minimum": 0 }
          }
        },
        "articles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["article_id", "source_hash", "risk_level", "status", "artifact_paths", "publication_blocked"],
            "properties": {
              "article_id": { "$ref": "#/$defs/non_empty_string" },
              "source_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "risk_level": { "enum": ["A", "B", "C", "pending"] },
              "status": { "$ref": "#/$defs/non_empty_string" },
              "artifact_paths": {
                "type": "array",
                "items": { "$ref": "#/$defs/non_empty_string" }
              },
              "publication_blocked": { "const": true }
            }
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "estimated", "input_tokens", "output_tokens"],
          "properties": {
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
            "estimated": { "type": "number", "minimum": 0 },
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
