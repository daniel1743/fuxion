# ========================================
# VARIABLES DE ENTORNO - FUXION SHOP
# ========================================
#
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env"
# 2. Reemplaza los valores "tu_*_aqui" con tus credenciales reales
# 3. NUNCA subas el archivo .env a GitHub (está en .gitignore)
#
# Para producción (Vercel/Netlify):
# - Agrega estas mismas variables en Settings → Environment Variables
# - Ver guía completa en: VARIABLES_ENTORNO_PRODUCCION.md
# ========================================

# ========================================
# SUPABASE - Base de datos y autenticación
# ========================================
# Obtén estas credenciales en: https://app.supabase.com
# → Tu proyecto → Settings → API
VITE_SUPABASE_URL=tu_url_aqui
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ========================================
# AI APIs - Sistema de fallback automático
# ========================================
# El sistema intenta en este orden: DeepSeek → Qwen → Gemini
# Si uno falla, usa el siguiente automáticamente
#
# ⚠️ IMPORTANTE: Las API keys ahora se usan desde el BACKEND (serverless)
# NO uses el prefijo VITE_ - estas variables solo son para el servidor
# ========================================

# DeepSeek (Prioridad 1 - REQUERIDO)
# Obtén tu API key en: https://platform.deepseek.com
# Uso: Asesor Premium, Bots del foro, Soporte
DEEPSEEK_API_KEY=tu_api_key_deepseek_aqui

# Qwen (Prioridad 2 - Fallback opcional)
# Obtén tu API key en: https://dashscope.aliyun.com
# Uso: Respaldo si DeepSeek falla
QWEN_API_KEY=tu_api_key_qwen_aqui

# Gemini (Prioridad 3 - Fallback opcional)
# Obtén tu API key en: https://aistudio.google.com/apikey
# Uso: Respaldo si DeepSeek y Qwen fallan
GEMINI_API_KEY=tu_api_key_gemini_aqui

# ========================================
# PRIORIDAD DE VARIABLES
# ========================================
#
# 🔴 CRÍTICAS (funcionalidades no funcionan sin estas):
#    • VITE_DEEPSEEK_API_KEY → IA (asesor, bots, soporte)
#
# 🟡 IMPORTANTES (mejoran seguridad y funcionalidad):
#    • VITE_SUPABASE_URL → Admin con base de datos
#    • VITE_SUPABASE_ANON_KEY → Admin con base de datos
#
# 🟢 OPCIONALES (redundancia y fallback):
#    • VITE_QWEN_API_KEY → Respaldo de IA
#    • VITE_GEMINI_API_KEY → Respaldo de IA
#
# ========================================
# DOCUMENTACIÓN COMPLETA
# ========================================
# Ver: VARIABLES_ENTORNO_PRODUCCION.md
# ========================================
